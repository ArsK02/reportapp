{
  "expo": {
    "name": "Report App",
    "slug": "report-app",
    "scheme": "reportapp",
    "version": "2.0.0",
    "owner": "Arsen Kylnyk",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.reportapp.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "en",
          "es",
          "ru",
          "uk"
        ],
        "CFBundleDevelopmentRegion": "en"
      }
    },
    "android": {
      "versionCode": 20001,
      "package": "com.reportapp.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "locales": {
      "en": "./localization/native/en.json",
      "es": "./localization/native/es.json",
      "ru": "./localization/native/ru.json",
      "uk": "./localization/native/uk.json"
    },
    "extra": {
      "eas": {
        "projectId": "31b49a0c-2ac6-402f-a627-c7789185b919"
      }
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
